name: 微博助手
description: 微博助手@ddgksf2013
author: ddgksf2013[https://t.me/ddgksf2021]
homepage: https://hub.hin0ka.com
icon: https://hub.hin0ka.com/modules/icons/Weibo.png
dns: {}
scriptings:
- http_request:
    name: weibo_0
    match: ^https://api\.weibo\.cn/__qx_weibo_settings__/(?:api/config)?(?=[?#]|$)
    script_url: https://raw.githubusercontent.com/canff/surge/refs/heads/main/js/weibo_json.js
    timeout: 10
    body_required: true
- http_request:
    name: weibo_1
    match: ^https://api\.weibo\.cn/__qx_weibo_settings__/api/(?:save|reset)(?=[?#]|$)
    script_url: https://raw.githubusercontent.com/canff/surge/refs/heads/main/js/weibo_json.js
    timeout: 10
    body_required: true
- http_response:
    name: weibo_2
    match: ^https?://api\.weibo\.cn(?:/2/statuses/container_timeline_hot|/2/guest/container_timeline_hot|/2/statuses/container_timeline_unread|/2/statuses/container_timeline|/2/live/media_homelist|/2/remind/hometab_dot|/2/remind/unread_count|/2/statuses/container_detail|/2/statuses/container_detail_comment|/2/comments/build_comments|/2/search/finder|/2/search/container_timeline|/2/search/container_discover|/2/!/was/finder/searchbarchange|/2/cardlist|/2/profile/me|/2/video/flow_stream|/2/video/flow_stream_cache|/2/push/daily|/2/push/active|/2/guest/push_active|/2/groups/allgroups/v2|/2/client/abserver_list|/2/checkin/show|/2/video/remind_info|/2/video/home_channels)(?=[?#]|$)
    script_url: https://raw.githubusercontent.com/canff/surge/refs/heads/main/js/weibo_json.js
    timeout: 10
    body_required: true
- http_response:
    name: weibo_3
    match: ^https?://bootpreload\.uve\.weibo\.com(?:/v2/ad/preload)(?=[?#]|$)
    script_url: https://raw.githubusercontent.com/canff/surge/refs/heads/main/js/weibo_json.js
    timeout: 10
    body_required: true
- http_response:
    name: weibo_4
    match: ^https?://wbapp\.uve\.weibo\.com(?:/wbapplua/wbpullad\.lua)(?=[?#]|$)
    script_url: https://raw.githubusercontent.com/canff/surge/refs/heads/main/js/weibo_json.js
    timeout: 10
    body_required: true
mitm:
  hostnames:
    includes:
    - api.weibo.cn
    - bootpreload.uve.weibo.com
    - wbapp.uve.weibo.com
