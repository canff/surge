name: Apple WLOC 定位修改
description: '修改 Apple 网络定位返回坐标 | 快捷指令(推荐): 设置地理位置 https://www.icloud.com/shortcuts/a82717d8fdad4e6280866fcf911173f7 清理恢复位置 https://www.icloud.com/shortcuts/f42632d406504f24a2cd163af4fe012f'
compat_arguments:
  longitude: '113.94114'
  latitude: '22.544577'
  accuracy: '25'
  logLevel: info
compat_arguments_schema:
  longitude:
    name: 经度(在线选点优先)
    default_value: '113.94114'
  latitude:
    name: 纬度(在线选点优先)
    default_value: '22.544577'
  accuracy:
    name: 精度(米)
    default_value: '25'
  logLevel:
    name: 日志级别
    default_value: info
    options:
    - info
    - off
    - error
    - warn
    - debug
    - all
open_url: https://wloc-pages.pages.dev/
author: Yu9191 Rewrite
homepage: https://github.com/Yu9191/wloc
icon: https://raw.githubusercontent.com/Yu9191/wloc/refs/heads/main/wloc.jpg
dns: {}
scriptings:
- http_response:
    name: Apple WLOC
    match: ^https?:\/\/gs-loc(-cn)?\.apple\.com\/clls\/wloc
    script_url: https://raw.githubusercontent.com/Yu9191/wloc/refs/heads/main/dist/wloc.js
    env:
      _compat.$argument: '{"longitude":"113.94114","latitude":"22.544577","accuracy":"25","logLevel":"info"}'
    timeout: 30
    body_required: true
    binary_body: true
- http_request:
    name: WLOC Settings
    match: ^https?:\/\/gs-loc(-cn)?\.apple\.com\/wloc-settings\/save
    script_url: https://raw.githubusercontent.com/Yu9191/wloc/refs/heads/main/dist/wloc-settings.js
    timeout: 10
mitm:
  hostnames:
    includes:
    - gs-loc.apple.com
    - gs-loc-cn.apple.com
